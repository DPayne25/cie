use chrono::{Duration, Utc};

enum AccountType {
    Checking,
    Savings,
}

struct Account {
    id: u64,
    user_id: u64,
    account_name: String,
    account_type: AccountType,
    current_balance: f64,
    available_balance: f64,
    last_synced_at: chrono::DateTime<Utc>,
}

impl Account {
    fn float_gap(&self) -> f64 {
        self.current_balance - self.available_balance
    }
    fn is_stale(&self) -> bool {
        Utc::now() - self.last_synced_at > Duration::hours(24)
    }
}

fn main() {
    let hr30 = Utc::now() - Duration::hours(30);
    let hr15 = Utc::now() - Duration::hours(15);

    let a1 = Account {
        id: 1,
        user_id: 1,
        account_name: String::from("Ideal"),
        account_type: AccountType::Checking,
        current_balance: 1500000.00,
        available_balance: 1300000.00,
        last_synced_at: hr30,
    };

    let a1_holds = a1.float_gap();
    let a1_stale = a1.is_stale();


    let a2 = Account {
        id: 1,
        user_id: 1,
        account_name: String::from("Second"),
        account_type: AccountType::Savings,
        current_balance: 1504550.00,
        available_balance: 1300000.00,
        last_synced_at: hr15,
    };

    let a2_holds = a2.float_gap();
    let a2_stale = a2.is_stale();

    println!("Account Name: {}", a1.account_name);
    println!("Holds: {}", a1_holds);
    println!("Is Stale?: {}", a1_stale);

    println!("Account Name: {}", a2.account_name);
    println!("Holds: {}", a2_holds);
    println!("Is Stale?: {}", a2_stale);   
}
